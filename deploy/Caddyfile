# /etc/caddy/Caddyfile — replace campus.example.edu with your domain.
# Caddy fetches and renews the HTTPS certificate automatically.

campus.example.edu {
	# Compress pages and assets, but never the live event streams.
	encode {
		gzip
		zstd
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type application/json*
			header Content-Type application/manifest+json*
			header Content-Type image/svg+xml*
		}
	}

	# Recordings can be up to 18 MB.
	request_body {
		max_size 20MB
	}

	reverse_proxy 127.0.0.1:3100 {
		# Pass Server-Sent Events (live updates, streamed AI answers) through immediately.
		flush_interval -1
	}
}
