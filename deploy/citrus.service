# /etc/systemd/system/citrus.service
# Starts Citrus on boot and restarts it if it crashes.
[Unit]
Description=Citrus
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=citrus
Group=citrus
WorkingDirectory=/opt/citrus
ExecStart=/usr/bin/node --env-file=/opt/citrus/.env server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

# Hardening: the app can only write to its own data folders.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/citrus/storage /opt/citrus/backups

[Install]
WantedBy=multi-user.target
