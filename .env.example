# CampusOS — copy this file to .env and fill in what you need.
# NEVER commit or share your real .env. Everything below is optional unless marked REQUIRED.

# --- Basics -------------------------------------------------------------------
# Edition (branding + campus guide): "oth" or "general". Same code, different theme.
CAMPUS_EDITION=oth
PORT=3100
# 0.0.0.0 = phones and laptops on the same network can open Campus OS (Windows asks once
# to allow Node.js on private networks: allow it). 127.0.0.1 = this computer only.
HOST=0.0.0.0
# The address people use to reach Campus OS (SSO callbacks, calendar links). Leave empty on
# your own network: links then follow whatever address each visitor used. Set it for a public server.
PUBLIC_URL=
# Set to 1 when served over HTTPS (also enabled automatically if PUBLIC_URL starts with https).
COOKIE_SECURE=0
# Set to 1 when CampusOS sits behind a reverse proxy or tunnel (Caddy, nginx, Cloudflare).
TRUST_PROXY=0
LOG_REQUESTS=0

# --- First administrator (REQUIRED for a new installation) ---------------------
CAMPUS_ADMIN_EMAIL=admin@example.edu
CAMPUS_ADMIN_PASSWORD=
# Name for a brand-new database (existing databases keep their name).
CAMPUS_DEFAULT_INSTITUTION=OTH Amberg-Weiden - Independent Concept

# --- AI (choose the provider in Admin → AI & knowledge) ------------------------
# Vercel AI Gateway is the only AI connection. Saved Admin choices take precedence.
# Default when no institution choice has been saved: gateway | off
CAMPUS_AI_PROVIDER=gateway
AI_GATEWAY_API_KEY=
# Default model for chat, tutoring and practice questions.
CAMPUS_AI_DEFAULT_MODEL=openai/gpt-6.1-terra
# Summary model for minutes, captions and feedback.
CAMPUS_AI_SUMMARY_MODEL=openai/gpt-6-luna
CAMPUS_AI_RATE_PER_MINUTE=12

# --- University single sign-on (OpenID Connect) --------------------------------
# Works with Keycloak, Entra ID, Google, Shibboleth IdP (OIDC plugin) or a SAML→OIDC bridge.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL=University login
# OIDC_REDIRECT_URI defaults to PUBLIC_URL/auth/sso/callback — register that URL with your IdP.
# Optional: map a claim to lecturer requests (e.g. eduPersonAffiliation = faculty/staff).
OIDC_ROLE_CLAIM=
OIDC_LECTURER_VALUES=faculty,staff,employee
# 1 = grant lecturer role directly from the claim (only if your IdP data is authoritative).
OIDC_TRUST_ROLE_CLAIM=0
OIDC_AUTO_CREATE=1

# --- Moodle --------------------------------------------------------------------
# Base URL of your Moodle with web services enabled, e.g. https://moodle.example.edu
MOODLE_URL=

# --- Push notifications --------------------------------------------------------
# Contact for push services (VAPID). Keys are generated automatically in storage/.
PUSH_SUBJECT=mailto:admin@example.edu
